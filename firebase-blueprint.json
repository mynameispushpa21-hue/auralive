{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with voice room settings, wallet coins, and role details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numericId": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "country": { "type": "string" },
        "role": { "type": "string" },
        "coins": { "type": "number" },
        "diamonds": { "type": "number" },
        "level": { "type": "number" },
        "vipTier": { "type": "string" },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "username", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered app user profiles"
    }
  }
}
